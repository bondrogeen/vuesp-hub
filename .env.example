# Vuesp hub (headless) configuration
# Copy to .env and fill in real values: cp .env.example .env
VUESP_HOST=127.0.0.1
VUESP_PORT=3005
VUESP_DATA_DIR=/absolute/path/to/vuesp-hub-data

# Master key for device credentials (AES-256-GCM).
# Generate with: openssl rand -hex 32
VUESP_SECRET_KEY=

# Optional: JWT signing secret. If empty, a secret is generated in the data directory.
# VUESP_JWT_SECRET=

# Optional overrides
# VUESP_WORKER_SCRIPT=/absolute/path/to/worker-script.cjs
# VUESP_FFMPEG_PATH=/usr/bin/ffmpeg
# Module catalog: HTTPS URL or a local catalog.json path.
# VUESP_MODULES_CATALOG=https://modules.vuesp.ru/catalog.json

# Yandex OAuth app for the Alice integration.
# Register at https://oauth.yandex.ru/client/new and copy the credentials here.
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=

# Optional public OAuth app id with iot:view and iot:control scopes.
# It pre-fills the "Get a token" helper on the smart home page.
# YANDEX_IOT_CLIENT_ID=
